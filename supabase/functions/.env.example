# Local environment for `npm run functions:serve` (supabase functions serve).
# Copy to supabase/functions/.env (git-ignored). Variable names only; no secrets here.
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the CLI for the local stack and by the platform in production.
# They must never be written into this file or any committed file.

# Browser origin allowed by CORS. Comma-separated list for several origins.
ALLOWED_ORIGIN=http://localhost:5173
